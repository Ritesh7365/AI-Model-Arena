# Server
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_model_arena?schema=public"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173

# n8n webhooks (selected automatically by NODE_ENV)
# development → N8N_TEST_WEBHOOK_URL
# otherwise   → N8N_PRODUCTION_WEBHOOK_URL
N8N_TEST_WEBHOOK_URL=http://localhost:5678/webhook-test/compare-models
N8N_PRODUCTION_WEBHOOK_URL=http://localhost:5678/webhook/compare-models

# Optional legacy fallback (still supported):
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/compare-models
